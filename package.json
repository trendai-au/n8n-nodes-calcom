{
	"name": "n8n-nodes-calcom",
	"version": "0.1.2",
	"description": "n8n community node for Cal.com — bookings and event types",
	"license": "MIT",
	"homepage": "https://github.com/trendai-au/n8n-nodes-calcom",
	"keywords": [
		"n8n-community-node-package",
		"cal.com",
		"calcom",
		"scheduling",
		"bookings"
	],
	"author": {
		"name": "Tai Vu",
		"email": "tai@trendai.au"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/trendai-au/n8n-nodes-calcom.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CalComApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CalCom/CalCom.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
